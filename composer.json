{
    "name": "ErebusLabs/MarketplaceScript",
    "type": "project",
    "description": "Erebus Marketplace Script is a JavaScript-Free, privacy focused, Monero only marketplace script. Erebus Marketplace Script was developed as the successor of Kabus Marketplace Script by Sukunetsiz.",
    "keywords": ["marketplace", "script", "privacy", "monero", "anonymous", "shopping", "deals"],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "comely-io/buffer-php": "^0.1.17",
        "endroid/qr-code": "^5.1",
        "ezyang/htmlpurifier": "^4.17",
        "furqansiddiqui/bip39-mnemonic-php": "^0.1.7",
        "guzzlehttp/guzzle": "^7.9.3",
        "intervention/image-laravel": "^1.3",
        "laravel/framework": "^13.16.1",
        "mobicms/captcha": "^4.0",
        "monero-integrations/monerophp": "dev-master",
        "spatie/laravel-csp": "^3.22"
    },
    "replace": {
        "charcoal-php/buffers": "1.0.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "laravel/tinker": "*",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
